<view class="container">
  <!-- 顶部状态栏占位 -->
  <view style="height: {{navHeight}}px"></view>

  <scroll-view scroll-y class="main-content">
    
    <!-- 1. 顶部轮播图 -->
    <swiper
      class="poster-section"
      autoplay="true"
      circular="true"
      interval="3000"
      duration="500"
      indicator-dots="{{banners.length > 1}}"
      indicator-color="rgba(255, 255, 255, 0.5)"
      indicator-active-color="#ffffff"
    >
      <block wx:for="{{banners}}" wx:key="*this">
        <swiper-item>
          <image class="top-poster" src="{{item}}" mode="aspectFill"></image>
        </swiper-item>
      </block>
    </swiper>
    
    <!-- 2. 民宿政策与联系方式 -->
    <view class="policy-bar">
      <text>*为了保证居住体验</text>
      <text>民宿禁止携带15岁以下儿童、宠物以及全域禁烟。</text>
      
      <!-- 微信号一键复制模块 -->
      <view bindtap="copyWechat" style="display: inline-flex; align-items: center; justify-content: center; margin-top: 8rpx; padding: 6rpx 12rpx; border-radius: 8rpx;">
        <text style="color: #333;">微信:mzz1806</text>
        <view style="margin-left: 12rpx; display: flex; align-items: center; justify-content: center; background: rgba(163, 167, 119, 0.25); width: 46rpx; height: 46rpx; border-radius: 50%;">
          <image src="data:image/svg+xml;base64," style="width: 26rpx; height: 26rpx;" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 3. 实时天气与主理人心情小组件 -->
    <view class="weather-mood-widget">
      <!-- 客观天气 -->
      <view class="weather-info">
      
      <!-- 天气图标智能转换工具 (WXS) -->
      <wxs module="iconTools">
          module.exports = {
            getIcon: function(text) {
              if (!text) return '☁️';
              if (text.indexOf('晴') !== -1) return '☀️';
              if (text.indexOf('云') !== -1) return '⛅';
              if (text.indexOf('阴') !== -1) return '☁️';
              if (text.indexOf('雷') !== -1) return '⛈️';
              if (text.indexOf('雨') !== -1) return '🌧️';
              if (text.indexOf('雪') !== -1) return '❄️';
              if (text.indexOf('冰') !== -1 || text.indexOf('雹') !== -1) return '🌨️';
              if (text.indexOf('雾') !== -1 || text.indexOf('霾') !== -1) return '🌫️';
              if (text.indexOf('风') !== -1) return '💨';
              return '☁️'; // 兜底默认图标
            }
          }
        </wxs>

        <!-- 极简气温行排版 -->
        <view class="temp-box">
          <!-- 这里的 iconTools.getIcon 是之前用 WXS 智能判断天气的工具，或者你之前用的三元表达式 -->
          <text class="weather-icon">{{iconTools.getIcon ? iconTools.getIcon(weather.text) : (weather.text == '晴' ? '☀️' : (weather.text == '多云' ? '⛅' : '☁️'))}}</text>
          <text class="temp-bold">{{weather.tempRange}}</text>
        </view>

        <view class="advice-box">
          <view class="advice-item">
            <text class="advice-title">穿衣提示：</text>
            <text class="advice-content">{{weather.advice}}</text>
          </view>
          <view class="advice-item">
            <text class="advice-title">紫外线指数：</text>
            <text class="advice-content">{{weather.uv}}</text>
          </view>
        </view>
      </view>

      <!-- 心情区域 -->
      <view class="mood-info" wx:if="{{todayMood}}">
        <text class="quote-mark">❝ </text>
        <text class="mood-text">{{todayMood}}</text>
        <text class="quote-mark-end"> ❞</text>
      </view>
    </view>

    <!-- 4. 房间列表网格 -->
    <view class="room-grid">
      <view
        class="room-card"
        wx:for="{{roomList}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <image
          class="room-img"
          src="{{item.img}}"
          mode="aspectFill"
        />
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <text class="card-tag">{{item.tag}}</text>
        </view>
      </view>
    </view>
    
    <view class="footer-spacer"></view>
  </scroll-view>

  <!-- 5. 底部自定义导航栏 -->
  <view class="custom-tabbar">
    <view class="tab-item active">看个房间</view>
    <view class="tab-item" bindtap="navToNotes">碎碎念</view>
    <view class="tab-item" bindtap="navToMassage">分享</view>
    <view class="tab-item" bindtap="navToMy">我的</view>
  </view>
</view>