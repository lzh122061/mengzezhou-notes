<view class="container">
  <view class="safe-top" style="height: calc(env(safe-area-inset-top) + 100rpx); min-height: 180rpx;"></view>

  <view class="profile-header">
    <view class="avatar-wrap" bindtap="handleLogin">
      <view class="avatar-inner">
        <image wx:if="{{isLogged && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" style="width:100%; height:100%;"></image>
        <image wx:else src="https://img.icons8.com/bubbles/200/user-male-circle.png" mode="aspectFill" style="width:100%; height:100%;"></image>
      </view>
    </view>
    
    <view class="info-wrap" bindtap="handleLogin">
      <view class="nickname">
        <text wx:if="{{isLogged}}">{{userInfo.nickName}}</text>
        <text wx:else>点击登录</text>
      </view>
      <view class="status-tag" wx:if="{{isLogged}}">
        <text>{{isAdmin ? '管理员' : '认证房客'}}</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToAdminPage">
      <view class="item-left">
        <text class="icon">🔧</text>
        <text class="text">9¾站台</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="showNotice">
      <view class="item-left">
        <text class="icon">📝</text>
        <text class="text">别点我</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="handleContact">
      <view class="item-left">
        <text class="icon">📞</text>
        <text class="text">联系小红花or刘不行</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="admin-action" wx:if="{{isAdmin}}">
    </view>

  <view class="custom-tabbar">
    <view class="tab-item" bindtap="navToHome">看个房间</view>
    <view class="tab-item" bindtap="navToNotes">碎碎念</view>
    <view class="tab-item" bindtap="navToMassage">分享</view>
    <view class="tab-item active">我的</view>
  </view>

  <view class="custom-modal" wx:if="{{showNoticeModal}}" catchtouchmove="true">
    <view class="modal-mask" bindtap="closeNotice"></view>
    <view class="modal-content">
      <view class="modal-header">提示</view>
      <image class="cheeky-img" src="https://img.icons8.com/bubbles/200/cat.png" mode="aspectFit"></image>
      <view class="modal-text">{{randomNotice}}</view>
      <button class="modal-btn" bindtap="closeNotice">.........</button>
    </view>
  </view>

  <view class="custom-modal" wx:if="{{showContactModal}}" catchtouchmove="true">
    <view class="modal-mask" bindtap="closeContactModal"></view>
    <view class="modal-content">
      <view class="modal-header">联系方式</view>
      <image class="cheeky-img" src="https://img.icons8.com/bubbles/200/phone.png" mode="aspectFit"></image>
      <view class="modal-text"><text>非必要勿打电话\n微信:mzz1806\n电话:13398720094</text></view>
      <view class="btn-row">
        <button class="modal-btn cancel" bindtap="closeContactModal">取消</button>
        <button class="modal-btn confirm" bindtap="confirmCall">呼叫</button>
      </view>
    </view>
  </view>

  <view class="custom-modal" wx:if="{{showLoginEditModal}}">
    <view class="modal-mask"></view>
    <view class="modal-content">
      <view class="modal-header">完善信息</view>
      
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" style="padding:0; width:160rpx; height:160rpx; border-radius:50%; margin-bottom:30rpx;">
        <image class="modal-avatar" src="{{tempAvatarUrl || 'https://img.icons8.com/bubbles/200/user-male-circle.png'}}" style="width:160rpx; height:160rpx; border-radius:50%;"></image>
      </button>
      <text style="font-size:24rpx; color:#7a8b7a; margin-bottom:30rpx;">点击圆圈选择头像</text>

      <input type="nickname" class="nickname-input" placeholder="请在此输入昵称" bindblur="onInputNickname" style="width:80%; height:80rpx; background:#f2edd0; border-radius:12rpx; text-align:center; margin-bottom:40rpx;" />

      <button class="modal-btn" bindtap="saveUserInfoAndLogin">保存并登录</button>
    </view>
  </view>

</view>