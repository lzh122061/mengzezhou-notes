<view class="container">
  <!-- 
    直接在 WXML 中通过 style 属性设置高度。
    env(safe-area-inset-top) 获取状态栏高度，
    + 100rpx 是为了避开胶囊按钮和留出一点呼吸感。
  -->
  <view class="safe-top" style="height: calc(env(safe-area-inset-top) + 100rpx); min-height: 180rpx;"></view>

  <!-- ============================================ -->
  <!-- 1. 头部用户信息区域 -->
  <!-- ============================================ -->
  <view class="profile-header">
    <!-- 头像 -->
    <view class="avatar-wrap" bindtap="handleLogin">
      <view class="avatar-inner">
        <open-data type="userAvatarUrl"></open-data>
      </view>
    </view>
    
    <!-- 昵称/登录提示 -->
    <view class="info-wrap" bindtap="handleLogin">
      <view class="nickname">
        <open-data wx:if="{{isLogged}}" type="userNickName"></open-data>
        <text wx:else>点击登录</text>
      </view>
      <view class="status-tag" wx:if="{{isLogged}}">
        <text>{{isAdmin ? '管理员' : '认证住客'}}</text>
      </view>
    </view>
  </view>

  <!-- ============================================ -->
  <!-- 2. 功能列表区域 -->
  <!-- ============================================ -->
  <view class="menu-list">
    <!-- 入住须知 -->
    <view class="menu-item" bindtap="showNotice">
      <view class="item-left">
        <text class="icon">📝</text>
        <text class="text">入住须知</text>
      </view>
      <text class="arrow">></text>
    </view>

    <!-- 联系管家 -->
    <view class="menu-item" bindtap="handleContact">
      <view class="item-left">
        <text class="icon">📞</text>
        <text class="text">联系小红花or刘不行</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- ============================================ -->
  <!-- 3. 管理员入口 (仅管理员验证成功后显示) -->
  <!-- ============================================ -->
  <view class="admin-action" wx:if="{{isAdmin}}">
    <button class="admin-btn" bindtap="goToAdminPage">点击进入管理员后台</button>
  </view>

  <!-- ============================================ -->
  <!-- 4. 底部导航栏 (固定在底部) -->
  <!-- ============================================ -->
  <view class="custom-tabbar">
    <view class="tab-item" bindtap="navToHome">看个房间</view>
    <view class="tab-item" bindtap="navToNotes">归家手记</view>
    <view class="tab-item" bindtap="navToMassage">一起分享</view>
    <view class="tab-item active">我的</view>
  </view>

</view>